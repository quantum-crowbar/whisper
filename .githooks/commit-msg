#!/bin/sh
# quantum-basics :: no-ai-metadata
# Strip LLM/AI attribution trailers from commit messages.
# Removes:
#   - Co-Authored-By: lines naming an AI tool
#   - "Generated with [Claude Code]" / "🤖 Generated with ..." lines
# Preserves human Co-Authored-By lines.
set -eu

msg="$1"
[ -f "$msg" ] || exit 0

tmp="$(mktemp)" || exit 0

# Drop AI attribution lines (case-insensitive).
grep -viE \
  '(^Co-Authored-By:.*(claude|anthropic|openai|gpt|copilot|cursor|gemini|codex|noreply@anthropic))|(Generated with .*(claude|cursor|copilot|codex|gpt|gemini))' \
  "$msg" > "$tmp" || true

# Only replace if content remains, and strip any trailing blank lines left behind.
if [ -s "$tmp" ]; then
  awk '{ lines[NR] = $0 }
       END {
         last = NR
         while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
         for (i = 1; i <= last; i++) print lines[i]
       }' "$tmp" > "$msg"
fi

rm -f "$tmp"
exit 0
